rules_version = '2';

// Reglas de seguridad de Firestore para FamiliApp.
//
// Cómo aplicarlas:
//   Firebase Console -> Firestore Database -> pestaña "Reglas"
//   -> pegar este contenido -> Publicar.
//
// Qué hacen: SOLO los dos emails autorizados pueden leer y escribir,
// y únicamente en la colección "menus_diarios". Todo lo demás queda
// bloqueado. Sin estas reglas, cualquiera con la config (que es pública
// en el HTML) podría leer o modificar los datos.

service cloud.firestore {
  match /databases/{database}/documents {

    function esFamilia() {
      return request.auth != null
        && request.auth.token.email in [
             'florenciabressan@gmail.com',
             'joselanglois@gmail.com'
           ];
    }

    match /menus_diarios/{fecha} {
      allow read, write: if esFamilia();
    }

    // Eventos (cumpleaños, actos, etc.) creados a mano o desde flyers.
    match /eventos/{id} {
      allow read, write: if esFamilia();
    }

    // Configuración compartida: horario de materias y links del comedor.
    match /config/{doc} {
      allow read, write: if esFamilia();
    }

    // Cualquier otra colección queda denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
